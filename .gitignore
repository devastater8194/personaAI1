# ──────────────────────────────────────────────
# Environment & Secrets (CRITICAL — never commit)
# ──────────────────────────────────────────────
.env
.env.*
.env.local
.env.development
.env.production
!.env.example

# Firebase / GCP service account keys
firebase_credentials.json
*-credentials.json
*.key.json
serviceAccount*.json

# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
venv/
venv311/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ──────────────────────────────────────────────
# Node / Frontend (supplement frontend/.gitignore)
# ──────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo

# ──────────────────────────────────────────────
# IDE & OS
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
.vercel
.turbo
